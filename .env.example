# Runtime
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
DEMO_SPEED=1

# Every normal run calls the live sponsor stack. Missing configuration fails closed.

# RocketRide SDK / WebSocket observability
ROCKETRIDE_URI=https://staging.rocketride.ai
ROCKETRIDE_APIKEY=
# May instead be supplied as an inherited OPENAI_API_KEY.
ROCKETRIDE_OPENAI_KEY=
ROCKETRIDE_PIPELINE_PATH=./pipeline/triage.pipe

# HydraDB managed API
HYDRA_API_URL=https://api.hydradb.com
HYDRA_API_KEY=
HYDRA_DATABASE=default-tenant
HYDRA_CAPTURE_COLLECTION=capture-memory
HYDRA_RESOLVED_COLLECTION=resolved-incidents
CAPTURE_MEMORY_API_URL=http://127.0.0.1:8000
CAPTURE_TARGET_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Cognee hosted tenant / Python fallback
COGNEE_PYTHON=python3
COGNEE_API_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=
COGNEE_USER_ID=
COGNEE_LLM_API_KEY=

# Modiqo / Rote CLI
ROTE_CLI=rote
# Local Rote target; no registry handle or publication is required.
ROTE_PLAY_URI=./rote/triage-remediation/main.ts

# Snyk CLI
SNYK_CLI=snyk
SNYK_TOKEN=
SNYK_ORG_ID=

# hotdata.dev
HOTDATA_API_URL=https://api.hotdata.dev/v1
HOTDATA_API_KEY=
HOTDATA_WORKSPACE_ID=
HOTDATA_DATABASE_ID=
HOTDATA_SCHEMA=public

# GitHub draft PR publisher
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_BASE_SHA=
